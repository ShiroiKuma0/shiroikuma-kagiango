<?xml version="1.0" encoding="utf-8"?>
<!-- 白い熊 鍵暗号 UI page section header (kxkb house style): a FULL-WIDTH hairline spacer marking the
     border with the previous group, then a big bold accent heading with a WORD-WIDTH underline —
     the underline is match_parent inside a wrap_content column, so it spans the text and no more. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="2dp">

    <!-- 1px = the thinnest line the display can draw. -->
    <View
        android:id="@+id/section_separator"
        android:layout_width="match_parent"
        android:layout_height="1px" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="Section" />

        <View
            android:id="@+id/section_divider"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
